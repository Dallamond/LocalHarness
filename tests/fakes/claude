#!/usr/bin/env python3
"""Falso `claude -p`: emite stream-json como el real (según docs) y crea un archivo en cwd."""
import json, sys
if "--boom" in sys.argv:
    sys.exit(3)
if sys.argv[1:3] == ["auth", "status"]:
    print(json.dumps({"authMethod": "claude.ai"})); sys.exit(0)
def out(o): print(json.dumps(o), flush=True)
if "--fail-result" in sys.argv:  # el CLI real reporta fallos con código 0 (visto en otros orquestadores)
    out({"type": "system", "subtype": "init", "session_id": "s"})
    out({"type": "result", "subtype": "error_during_execution", "is_error": True, "errors": ["boom"]})
    sys.exit(0)
out({"type": "system", "subtype": "init", "session_id": "sess-1", "model": "fake"})
out({"type": "assistant", "message": {"content": [{"type": "text", "text": "Voy a crear hola.txt"},
     {"type": "tool_use", "name": "Write", "input": {"file_path": "hola.txt"}}]}})
open("hola.txt", "w").write("hola\n")
out({"type": "result", "subtype": "success", "is_error": False, "result": "Hecho", "total_cost_usd": 0.01,
     "num_turns": 2, "session_id": "sess-1"})
