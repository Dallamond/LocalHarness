#!/usr/bin/env python3
"""Falso `claude -p`: emite stream-json como el real (verificado con la CLI 2.1.287) sin gastar nada.

Lee el prompt de stdin. Según el caso:
- `--json-schema` con `subtasks` → hace de Director: devuelve un plan (2 subtareas; 5 si el prompt dice GRANDE;
  una que borra README.md si dice BORRA). Agente elegido: el primero de la lista «- `nombre`».
- `--json-schema` con `verdict` → hace de jefe técnico: aprueba salvo que el diff contenga ESCALA.
- trabajador: crea el archivo indicado con «crea el archivo X» (por defecto hola.txt) o borra README.md con BORRA.
"""
import json, os, re, sys

if "--boom" in sys.argv:
    sys.exit(3)
if sys.argv[1:3] == ["auth", "status"]:
    print(json.dumps({"authMethod": "claude.ai"})); sys.exit(0)


# la CLI real escribe UTF-8; en Windows la salida por defecto de Python es cp1252 (rompe «✅» y los acentos)
sys.stdout.reconfigure(encoding="utf-8")


def out(o):
    print(json.dumps(o, ensure_ascii=False), flush=True)


try:
    sys.stdin.reconfigure(encoding="utf-8")
    prompt = sys.stdin.read()
except Exception:
    prompt = ""
if "--fail-result" in sys.argv:  # el CLI real reporta fallos con código 0
    out({"type": "system", "subtype": "init", "session_id": "s"})
    out({"type": "result", "subtype": "error_during_execution", "is_error": True, "errors": ["boom"]})
    sys.exit(0)

tools = sys.argv[sys.argv.index("--tools") + 1].split(",") if "--tools" in sys.argv else []
schema = json.loads(sys.argv[sys.argv.index("--json-schema") + 1]) if "--json-schema" in sys.argv else None
out({"type": "system", "subtype": "init", "session_id": "sess-1", "model": "fake", "tools": tools,
     "apiKeySource": "none"})
out({"type": "rate_limit_event", "rate_limit_info": {"status": "allowed", "rateLimitType": "five_hour",
     "utilization": 0.1, "unifiedWindows": {"five_hour": {"utilization": 0.1}, "seven_day": {"utilization": 0.5}}}})


def finish(result, structured=None, cost=0.01):
    o = {"type": "result", "subtype": "success", "is_error": False, "result": result, "total_cost_usd": cost,
         "num_turns": 2, "session_id": "sess-1"}
    if structured is not None:
        o["structured_output"] = structured
    out(o)


if schema and "subtasks" in schema.get("properties", {}):
    agents = re.findall(r"^- `([^`]+)`", prompt, re.M)
    agent = agents[0] if agents else "nadie"
    if "BORRA" in prompt:
        subs = [{"title": "Borrar README", "prompt": "BORRA el README.md", "agent": agent, "risk": "high"}]
    else:
        n = 5 if "GRANDE" in prompt else 2
        subs = [{"title": f"Paso {i}", "prompt": f"crea el archivo paso{i}.txt", "agent": agent, "risk": "low"}
                for i in range(1, n + 1)]
        if "ESCALA" in prompt:
            subs[-1]["prompt"] += " con el texto ESCALA"
    plan = {"summary": "plan falso", "risk": "high" if "BORRA" in prompt else "low", "subtasks": subs}
    out({"type": "assistant", "message": {"content": [{"type": "tool_use", "name": "StructuredOutput", "input": plan}]}})
    finish(json.dumps(plan, ensure_ascii=False), plan, cost=0.005)
elif schema and "subtask" in schema.get("properties", {}):
    # «rehacer este paso»: devuelve la subtarea nueva con lo que pidió el humano
    agent = (re.findall(r"^\d+\. .+ \(([^,]+), riesgo", prompt, re.M) or ["nadie"])[0]
    asked = prompt.split("LO QUE PIDE EL HUMANO:")[-1].split("Devuelve")[0].strip()
    sub = {"title": "Paso rehecho", "prompt": f"crea el archivo rehecho.txt ({asked})", "agent": agent, "risk": "low",
           "skills": ["tests-primero"]}
    finish(json.dumps({"subtask": sub}, ensure_ascii=False), {"subtask": sub}, cost=0.004)
elif schema and "verdict" in schema.get("properties", {}):
    v = ({"verdict": "escalate", "risk": "medium", "reason": "contenido dudoso"} if "ESCALA" in prompt.split("DIFF:")[-1]
         else {"verdict": "approve", "risk": "low", "reason": "correcto"})
    finish(json.dumps(v), v, cost=0.002)
elif "--mcp-config" in sys.argv and ("DELEGA" in prompt or "COORDINA" in prompt):
    # delegar: lanza el servidor MCP del archivo como haría el real y le encarga escribir un archivo
    import subprocess
    cfg = json.load(open(sys.argv[sys.argv.index("--mcp-config") + 1], encoding="utf-8"))["mcpServers"]["local"]
    srv = subprocess.Popen([cfg["command"], *cfg["args"]], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                           env={**os.environ, **cfg.get("env", {})})

    def rpc(i, method, params):
        srv.stdin.write((json.dumps({"jsonrpc": "2.0", "id": i, "method": method, "params": params}) + "\n").encode())
        srv.stdin.flush()
        return json.loads(srv.stdout.readline())

    rpc(1, "initialize", {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "falso"}})
    names = [t["name"] for t in rpc(2, "tools/list", {})["result"]["tools"]]
    if "COORDINA" in prompt:  # modo coordinador: el plan entero de una vez
        tool, args = "local_execute_plan", {"blocks": [
            {"id": "1", "title": "saludo", "kind": "write", "path": "a.txt", "instructions": "un saludo"},
            {"id": "2", "title": "despedida", "kind": "write", "path": "b.txt", "instructions": "una despedida"},
            {"id": "3", "title": "resumen", "kind": "ask", "instructions": "resume", "files": ["a.txt"]}]}
    else:
        tool, args = "local_write_file", {"path": "delegado.txt", "instructions": "un saludo"}
    out({"type": "assistant", "message": {"content": [{"type": "tool_use", "name": f"mcp__local__{tool}",
                                                       "input": args}]}})
    res = rpc(3, "tools/call", {"name": tool, "arguments": args})["result"]
    srv.stdin.close(); srv.wait(timeout=10)
    builtin = sys.argv[sys.argv.index("--tools") + 1]
    system = sys.argv[sys.argv.index("--append-system-prompt") + 1] if "--append-system-prompt" in sys.argv else ""
    coord = "MODO COORDINADOR" in system  # la guía va en el prompt de sistema, no en la tarea
    finish(f"Herramientas MCP: {','.join(names)}. Integradas: {builtin}. Coordinador: {coord}. "
           f"{res['content'][0]['text'][:80]}")
elif "--resume" in sys.argv and "te pregunta:" in prompt:
    # Director reanudado por `preguntar_director` de un agente local: responde sin tocar archivos
    sid = sys.argv[sys.argv.index("--resume") + 1]
    finish(f"Usa la opción A (Director, sesión {sid})", cost=0.003)
else:
    out({"type": "assistant", "message": {"content": [{"type": "text", "text": "Voy a trabajar"}]}})
    if "BORRA" in prompt and os.path.exists("README.md"):
        out({"type": "assistant", "message": {"content": [{"type": "tool_use", "name": "Bash", "input": {"command": "rm README.md"}}]}})
        os.remove("README.md")
    else:
        m = re.search(r"crea el archivo (\S+)", prompt)
        name = m.group(1) if m else "hola.txt"
        text = "ESCALA\n" if "ESCALA" in prompt else "hola\n"
        out({"type": "assistant", "message": {"content": [{"type": "tool_use", "name": "Write", "input": {"file_path": name}}]}})
        with open(name, "w", encoding="utf-8") as f:
            f.write(text)
    finish("Hecho (resume)" if "--resume" in sys.argv else "Hecho")
